# setup_local.py creates a private .env with a random key for local use.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
# Enable only behind a trusted HTTPS proxy which strips incoming forwarded headers.
DJANGO_TRUST_PROXY=false
# Set both locations to durable storage in production.
# DJANGO_DATA_DIR=/var/lib/portfolio/data
# DJANGO_MEDIA_ROOT=/var/lib/portfolio/media
